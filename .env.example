# 谁是卧底 · 本地开发配置
# 填写项目根目录下的 .env；程序启动时自动读取。
# .env 已加入 Git 忽略规则，请勿提交真实密钥。

# ---------- 应用 ----------
UNDERCOVER_ADDR=127.0.0.1:18080
# 使用 XBuilder 登录时关闭游客入口；需要本地游客试玩可改为 true。
UNDERCOVER_ALLOW_GUEST=false

# ---------- PostgreSQL / Redis：必填 ----------
# 先创建独立数据库；启动时自动创建 undercover_rooms 表。
# 房间、隐藏词卡和对局状态均存 PostgreSQL，不再使用 data 目录。
# 此处为本地配置示例，上线填写实际账号并按服务商要求开启 TLS。
DATABASE_URL=postgresql://undercover:change-me@127.0.0.1:5432/undercover?sslmode=disable
# Session 以随机 Token 的 SHA-256 哈希作为键，TTL 七天。
# 单实例使用 REDIS_URL，支持 redis:// / rediss://。
# 有密码时例如 redis://default:your-password@127.0.0.1:6379/0。
REDIS_URL=redis://127.0.0.1:6379/0
# Redis Cluster 与 spxbench 一样使用 REDIS_ADDR，非空时优先于 REDIS_URL。
# 例如 redis8.builder.svc.cluster.local:6379,redis8.builder.svc.cluster.local:6380,redis8.builder.svc.cluster.local:6381。
# Cluster 固定使用 DB 0；无认证时下面的用户名和密码留空。
REDIS_ADDR=
REDIS_USERNAME=
REDIS_PASSWORD=

# ---------- XBuilder 登录：必填 ----------
# 账号服务根地址，不要包含 /oauth/par、/oauth/token 或 /user。
# 例如：https://account.your-domain.example
XBUILDER_ACCOUNT_BASE_URL=
# 为本应用申请的 OAuth Client ID / Client Secret。
XBUILDER_ACCOUNT_CLIENT_ID=
XBUILDER_ACCOUNT_CLIENT_SECRET=
# 在 XBuilder 登记完全相同的回调地址（127.0.0.1 与 localhost 不可混用）。
# 上线后改成 https://你的域名/auth/callback，并同步更新 XBuilder 登记。
XBUILDER_ACCOUNT_REDIRECT_URL=http://127.0.0.1:18080/auth/callback
# 至少 32 字符的随机密钥；可运行 openssl rand -hex 32 生成。
# 本次创建的 .env 已自动生成，通常无需修改。
UNDERCOVER_SESSION_SECRET=

# ---------- 灵矽完整智能体：语音、对话、主持、MCP 工具 ----------
# 1. 在项目根目录运行：go run ./cmd/linx-device
# 2. 将输出的激活码绑定到灵矽控制台 → 智能体 → 设备管理。
# 3. 将工具输出的 MAC 填到下方，然后重启应用。后续复用同一个 MAC，不会生成 data 文件。
# 智能体提示词请参考 docs/linx-host-prompt.txt。工具通过 WebSocket 自动发现。
# 无需购买硬件。多个已绑定软件终端的 MAC 用英文逗号分隔。
LINX_DEVICE_IDS=

# AI 玩家由上面绑定的灵矽智能体提供，无需另外的 LLM 模型配置。

# ---------- 灵矽高级配置：通常全部留空 ----------
# 留空时使用内置的官方 OTA / WebSocket 地址。
LINX_OTA_URL=
LINX_WS_URL=
# 留空时通过 OTA 自动获取设备 Token，不需要手动复制。
LINX_WS_TOKEN=
# 仅供智能体管理 API 使用；当前语音链路不需要，不能替代设备绑定。
LINX_API_KEY=
